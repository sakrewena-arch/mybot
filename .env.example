# ─────────────────────────────────────────────────────────────
# mybot — environment configuration
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Environment: development | test | production
NODE_ENV=development

# Token obtained from @BotFather
BOT_TOKEN=1234567890:AAYourBotFatherTokenHere

# PostgreSQL connection string (matches docker-compose.yml by default)
DATABASE_URL=postgresql://mybot:mypassword@localhost:5432/mybot

# ── AI providers ───────────────────────────────────────────────
# OpenAI is ALWAYS the primary provider: put your paid key in OPENAI_API_KEY.
# See the "AI" section below for the full setup (incl. Groq fallback).

# Comma-separated Telegram user IDs allowed to use administrative commands
ADMIN_IDS=123456789,987654321

# ── HTTP / run mode ─────────────────────────────────────────
# HTTP port for the webhook + health check server
PORT=3000

# polling        → use long polling (simplest for local dev)
# webhook        → use a webhook; requires WEBHOOK_URL + WEBHOOK_SECRET
POLLING_MODE=polling

# Public HTTPS URL where the bot is reachable (required for webhook mode)
WEBHOOK_URL=https://your-domain.com/telegram/webhook
# Secret token Telegram will send in the X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Security ────────────────────────────────────────────────
# Optional whitelist of chat ids the business bot is allowed to serve.
# Leave empty to allow every chat granted by the business account owner.
ALLOWED_CHAT_IDS=

# Updates the bot asks Telegram to deliver (see Bot API `allowed_updates`)
ALLOWED_UPDATES=business_connection,business_message,edited_business_message,deleted_business_messages,message,callback_query,pre_checkout_query,purchased_paid_media

# ── AI ──────────────────────────────────────────────────────
# Le bot utilise OpenAI en premier (via OPENAI_API_KEY, fournisseur payé).
# Si/quand OpenAI atteint sa limite (429 / quota), le bot bascule
# automatiquement sur les providers listés dans AI_PROVIDERS_JSON (secours).

# Clé OpenAI officielle — OBLIGATOIRE (fournisseur principal).
OPENAI_API_KEY=sk-your-openai-api-key
# Laisser vide pour l'API officielle https://api.openai.com/v1
OPENAI_BASE_URL=

# Providers de SECOURS, utilisés uniquement quand OpenAI est sur quota
# (exemple : Groq). Chaque provider a sa clé/son URL/son modèle.
#     [ { "name": "groq", "apiKey": "gsk_...",
#         "baseUrl": "https://api.groq.com/openai/v1",
#         "model": "llama-3.3-70b-versatile", "supportsJsonMode": false } ]
# ⚠️ Utilisez un modèle GROQ robuste ("llama-3.3-70b-versatile" ou
#    "llama-3.1-8b-instant"). Évitez "openai/gpt-oss-20b" : il est faible pour
#    suivre le prompt et produit des réponses longues/robotiques.
AI_PROVIDERS_JSON=

# Exemples de providers de SECOURS (derrière OpenAI) :
#   2) Groq (gratuit/généreux MAIS limité : ~14 000 requêtes/jour, tokens/min)
#      aiProviders: { "name":"groq", "apiKey":"gsk_...",
#        "baseUrl":"https://api.groq.com/openai/v1",
#        "model":"llama-3.3-70b-versatile", "supportsJsonMode":false }
#   3) Google Gemini (via endpoint OpenAI)
#      aiProviders: { "name":"gemini", "apiKey":"AIza...",
#        "baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai/",
#        "model":"gemini-2.0-flash" }

AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=300
# How many recent messages are sent to the model every time
HISTORY_LIMIT=20

# ── Language ───────────────────────────────────────────────
# Fallback language when the bot must reply in a fixed language
DEFAULT_LANGUAGE=en
# en   → always reply in English
# user → try to match the user's language code (falls back to DEFAULT_LANGUAGE)
PREFER_LANGUAGE=en

# ── Paid media gating ──────────────────────────────────────
# Minimum delay between two paid-meda proposals for the same user
MEDIA_COOLDOWN_MINUTES=30
# MESSAGE_COUNT trigger: propose after this many inbound user messages
MEDIA_MESSAGE_THRESHOLD=3
# none | message_count | time | ai | manual
#   none          → never propose media automatically
#   message_count → after MEDIA_MESSAGE_THRESHOLD inbound messages
#   time          → after MEDIA_TIME_MINUTES since the last proposal
#   ai            → let the AI decide (it can only pick an existing media)
#   manual        → only via the /propose admin command
MEDIA_TRIGGER_MODE=ai
# TIME trigger: propose at most once every X minutes per user
MEDIA_TIME_MINUTES=240
# Propose a paid media right away when the user asks for a photo of Esther
# (French/English intent detection), in addition to the message threshold.
MEDIA_PHOTO_REQUEST_ENABLED=true

# ── Human-like replies (Esther) ───────────────────────────────
# The bot waits like a real person before reading AND replying.
# Set HUMANIZE_ENABLED=false to disable (e.g. automated tests / tools).
HUMANIZE_ENABLED=true
# Delay before Esther "notices" / reads the message (2-5 min).
HUMANIZE_READ_BASE_SECONDS=120
HUMANIZE_READ_MAX_SECONDS=300
# Base delay before writing the reply
HUMANIZE_BASE_SECONDS=10
# Random extra delay (0..X s) added on top
HUMANIZE_EXTRA_MAX_SECONDS=25
# Additional "typing time" per character of the reply
HUMANIZE_MS_PER_CHAR=45
# Hard cap on the total writing delay per reply
HUMANIZE_MAX_SECONDS=180

# ── Re-engagement (follow-ups) ─────────────────────────────────
# If a user does not reply, Esther gently nudges them again:
# first after REENGAGE_FIRST_DELAY_DAYS days, then every
# REENGAGE_SUBSEQUENT_DELAY_DAYS days, up to REENGAGE_MAX_MESSAGES
# unanswered nudges — then she gives up until the user writes again.
REENGAGE_ENABLED=true
REENGAGE_FIRST_DELAY_DAYS=3
REENGAGE_SUBSEQUENT_DELAY_DAYS=6
REENGAGE_MAX_MESSAGES=3
# How often the scheduler scans quiet chats (minutes).
REENGAGE_INTERVAL_MINUTES=60