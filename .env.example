# ─────────────────────────────────────────────────────────────
# mybot — environment configuration
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Environment: development | test | production
NODE_ENV=development

# Token obtained from @BotFather
BOT_TOKEN=1234567890:AAYourBotFatherTokenHere

# PostgreSQL connection string (matches docker-compose.yml by default)
DATABASE_URL=postgresql://mybot:mypassword@localhost:5432/mybot

# OpenAI API key
OPENAI_API_KEY=sk-your-openai-api-key
# Optional: base URL for an OpenAI-compatible provider (Groq, DeepSeek, etc.).
# Leave empty to use the official OpenAI platform.
# Ex: OPENAI_BASE_URL=https://api.groq.com/openai/v1  (remember to also set AI_MODEL)
OPENAI_BASE_URL=

# Comma-separated Telegram user IDs allowed to use administrative commands
ADMIN_IDS=123456789,987654321

# ── HTTP / run mode ─────────────────────────────────────────
# HTTP port for the webhook + health check server
PORT=3000

# polling        → use long polling (simplest for local dev)
# webhook        → use a webhook; requires WEBHOOK_URL + WEBHOOK_SECRET
POLLING_MODE=polling

# Public HTTPS URL where the bot is reachable (required for webhook mode)
WEBHOOK_URL=https://your-domain.com/telegram/webhook
# Secret token Telegram will send in the X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Security ────────────────────────────────────────────────
# Optional whitelist of chat ids the business bot is allowed to serve.
# Leave empty to allow every chat granted by the business account owner.
ALLOWED_CHAT_IDS=

# Updates the bot asks Telegram to deliver (see Bot API `allowed_updates`)
ALLOWED_UPDATES=business_connection,business_message,edited_business_message,deleted_business_messages,message,callback_query,pre_checkout_query,purchased_paid_media

# ── AI ──────────────────────────────────────────────────────
# Le bot parle à un fournisseur compatible OpenAI via OPENAI_BASE_URL.
# (Voir README section "Relais multi-fournisseurs" pour le mode failover.)

# Mode SIMPLE (1 fournisseur) — les variables ci-dessous suffisent :
#   OPENAI_API_KEY=sk-xxx
#   OPENAI_BASE_URL=https://api.deepseek.com   (laisser vide = OpenAI officiel)
#   AI_MODEL=deepseek-chat

# Mode RELAIS (2+ fournisseurs en failover automatique) :
# Remplissez AI_PROVIDERS_JSON ci-dessous et laissez OPENAI_API_KEY/OPENAI_BASE_URL
# vides (non utilisés). Chaque provider a sa clé/son URL/son modèle. Si un
# provider atteint son quota, le suivant répond automatiquement pendant que le
# quota se recharge (backoff 1-30 min selon l'erreur).
#     [ { "name": "deepseek", "apiKey": "sk-...",
#         "baseUrl": "https://api.deepseek.com", "model": "deepseek-chat" },
#       { "name": "groq", "apiKey": "gsk_...",
#         "baseUrl": "https://api.groq.com/openai/v1",
#         "model": "openai/gpt-oss-20b", "supportsJsonMode": true },
#       { "name": "gemini", "apiKey": "AIza...",
#         "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
#         "model": "gemini-2.0-flash" } ]
AI_PROVIDERS_JSON=

# Présélections complètes :

# 1) OpenAI officiel (payant, très bon marché)
#    OPENAI_API_KEY=sk-proj-xxx
#    OPENAI_BASE_URL=
#    AI_MODEL=gpt-4o-mini
#
# 2) DeepSeek (payant mais EXTREMEMENT bon marché, très fiable à grande échelle)
#    OPENAI_API_KEY=sk-xxx
#    OPENAI_BASE_URL=https://api.deepseek.com
#    AI_MODEL=deepseek-chat
#
# 3) Groq (gratuit/généreux MAIS limité : ~14 000 requêtes/jour, tokens/min)
#    OPENAI_API_KEY=gsk_xxx
#    OPENAI_BASE_URL=https://api.groq.com/openai/v1
#    AI_MODEL=openai/gpt-oss-20b   (llama-3.3-70b-versatile est passé en Enterprise)
#    supportsJsonMode:true pour les modèles gpt-oss (structured outputs OK)
#
# 4) Google Gemini (niveau gratuit + payant très flexible via endpoint OpenAI)
#    OPENAI_API_KEY=AIza...
#    OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#    AI_MODEL=gemini-2.0-flash
#
# 5) OpenRouter (modèles :free à tester, rate-limited ; modèles payants très bon marché)
#    OPENAI_API_KEY=sk-or-xxx
#    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#    AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=400
# How many recent messages are sent to the model every time
HISTORY_LIMIT=20

# ── Language ───────────────────────────────────────────────
# Fallback language when the bot must reply in a fixed language
DEFAULT_LANGUAGE=en
# en   → always reply in English
# user → try to match the user's language code (falls back to DEFAULT_LANGUAGE)
PREFER_LANGUAGE=en

# ── Paid media gating ──────────────────────────────────────
# Minimum delay between two paid-meda proposals for the same user
MEDIA_COOLDOWN_MINUTES=30
# MESSAGE_COUNT trigger: propose after this many inbound user messages
MEDIA_MESSAGE_THRESHOLD=10
# none | message_count | time | ai | manual
#   none          → never propose media automatically
#   message_count → after MEDIA_MESSAGE_THRESHOLD inbound messages
#   time          → after MEDIA_TIME_MINUTES since the last proposal
#   ai            → let the AI decide (it can only pick an existing media)
#   manual        → only via the /propose admin command
MEDIA_TRIGGER_MODE=ai
# TIME trigger: propose at most once every X minutes per user
MEDIA_TIME_MINUTES=240

# ── Human-like replies ───────────────────────────────────────
# Makes the bot feel like a real person: shows a "typing…" indicator and waits
# a believable amount of time before answering (longer replies take longer).
# Set HUMANIZE_ENABLED=false to disable (e.g. automated tests / tools).
HUMANIZE_ENABLED=true
# Base delay before any reply
HUMANIZE_BASE_SECONDS=4
# Random extra delay (0..X s) added on top
HUMANIZE_EXTRA_MAX_SECONDS=10
# Additional "typing time" per character of the reply
HUMANIZE_MS_PER_CHAR=40
# Hard cap on the total delay per reply
HUMANIZE_MAX_SECONDS=180